# ---------------------------------------------------------------------------
# Deal Rescue Agent — environment (see docs/configuration.md)
# Phase 1 runs entirely on fixtures: leave TOOL_MODE=fake.
# ---------------------------------------------------------------------------

# Global tool mode: fake | live. Per-tool vars below override it.
TOOL_MODE=fake

# Deterministic "today" for the demo. Unset = real current date.
AS_OF=2026-09-20

# --- Orchestrator knobs (spec §11) ----------------------------------------
STALL_DAYS=14
SHORTLIST_N=5
# risk (rescue queue) | exposure (pipeline hygiene)
SHORTLIST_RANKING=risk
# The daily batch (D1): the API server refreshes the shortlist on this
# interval while it runs. 0 = manual refresh only.
SHORTLIST_REFRESH_HOURS=24
MAX_SYNTH_RETRIES=2

# --- Deal score rubric weights (spec §7) ----------------------------------
SCORE_DAYS_SILENT_CAP=45
SCORE_DAYS_SILENT_WEIGHT=1.0
SCORE_CLOSE_DATE_PUSH_WEIGHT=8.0
SCORE_STAGE_REGRESSION_WEIGHT=15.0
SCORE_ACTIVITY_SLOPE_WEIGHT=10.0
SCORE_LLM_ADJUSTMENT_BOUND=15

# Easiest path: `python -m deal_rescue.cli setup` fills the Salesforce and
# Tavily values below via a browser login and a validated key prompt.

# --- Tool: salesforce_reads (MCP) -----------------------------------------
SF_MODE=
SF_MCP_URL=
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=
# Stored by `cli setup` after a browser login; wins over the JWT flow above.
SF_REFRESH_TOKEN=
SF_CLIENT_SECRET=
SF_CALLBACK_PORT=1717
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=62.0
SF_OPPORTUNITY_FILTER=
# The org's stage pipeline in order, comma separated. Unset = fixture vocabulary.
SF_STAGE_ORDER=

# --- Tool: salesforce_writeback (MCP) -------------------------------------
SF_WRITEBACK_MODE=

# --- Tool: web_research ----------------------------------------------------
WEB_MODE=
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# --- Tool: transcript (Google Drive) --------------------------------------
TRANSCRIPT_MODE=
# User OAuth, stored by `cli setup`: a Desktop-type OAuth client from the
# Google Cloud console + the refresh token the Gmail login stores.
# Scope is READ-ONLY Drive; this login cannot send mail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: confine the transcript search to one Drive folder.
GOOGLE_DRIVE_FOLDER_ID=
# Service-account alternative (headless), unused by `cli setup`:
GOOGLE_CREDENTIALS_PATH=

# --- Tool: agentforce (the synthesis step) --------------------------------
AGENTFORCE_MODE=
# Which backend supplies judgment when the mode is live:
#   anthropic (default) -> Claude via the Anthropic API; needs ANTHROPIC_API_KEY
#   agentforce          -> Agentforce Agent API behind an MCP wrapper (Phase 2.4)
SYNTHESIS_PROVIDER=
ANTHROPIC_API_KEY=
SYNTHESIS_MODEL=
AGENTFORCE_MCP_URL=
AGENTFORCE_AGENT_ID=
AGENTFORCE_API_URL=
# Fake-only fault injection for exercising the validation gate:
# unset | invented_date | invented_source | permanent
AGENTFORCE_FAKE_FAULT=

# --- Tool: storymydata (plain HTTPS) --------------------------------------
STORYMYDATA_MODE=
STORYMYDATA_BASE_URL=
STORYMYDATA_API_KEY=

# --- LangSmith tracing (spec §4.4) ----------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deal-rescue-agent
