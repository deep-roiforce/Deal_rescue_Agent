<?xml version="1.0" encoding="UTF-8"?>
<!--
  Least-privilege access for the Deal Rescue orchestrator's integration user.

  This file is the answer to "what can this agent actually do to my org". Keep
  it short enough to screenshot. No Delete anywhere, no View All, no Modify All,
  no Apex, and edit access on exactly six custom fields.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Deal Rescue Integration</label>
    <description>Read org data and write back rescue results. No delete, no View All, edit limited to the six Rescue custom fields.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- API access. Minimum Access profiles do not have this, and the JWT login
         fails with a misleading error without it. -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>

    <!-- Read the deal, write back the four result fields. -->
    <objectPermissions>
        <object>Opportunity</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- The draft and the audit trail. Create + Edit so the upsert works. -->
    <objectPermissions>
        <object>Task</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Read-only: context for research and the activity timeline signals. -->
    <objectPermissions>
        <object>Account</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Event</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Opportunity result fields -->
    <fieldPermissions>
        <field>Opportunity.Rescue_Base_Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Rescue_Base_Signals__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Rescue_Days_Silent__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Rescue_Health_Score__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Rescue_Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Rescue_Signals__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Replay_URL__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Rescue_Evidence_Level__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <!-- Activity fields, addressed per-entity as Task.* for field-level security -->
    <fieldPermissions>
        <field>Task.Rescue_Draft_Approved__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Task.Rescue_Run_Key__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>DealRescueScore</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DealRescueScoreBatch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
